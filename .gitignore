packages/zsh/.zsh/local.zsh
packages/git/.config/git/config.d/local.conf
packages/claude/.claude/lint/node_modules/
packages/yazi/.local/
packages/yazi/.cache/
# Karabiner が設定変更のたびに書き出すバックアップ
packages/karabiner/.config/karabiner/automatic_backups/
__pycache__/
*.pyc
.claude/notes/
# packages/ に入ると stow が ~/.DS_Store と衝突し、全リンク作成が中止される
.DS_Store

# claude.ai から同期される組み込みスキル。~/.claude の実体と同一なので削除せず除外する
packages/claude/.claude/skills/synced/
# claude-loop の通知先と認証トークン。stow で ~/.config/claude-loop がこのディレクトリを指すため、置いた実体がここに入る
packages/claude/.config/claude-loop/env
# ハーネス改善ループが公開前に弾く固有名の一覧。一覧そのものが非公開の情報
packages/claude/.config/claude-loop/denylist
