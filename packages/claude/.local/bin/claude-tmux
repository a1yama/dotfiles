#!/usr/bin/env bash
set -euo pipefail

AGENT_PREFIX="🤖"
# テストから隔離したディレクトリを指せるように環境変数で上書きできる
AGENTS_DIR="${CLAUDE_TMUX_AGENTS_DIR:-/tmp/claude-agents}"
SKILL_DIR="$HOME/.claude/skills/code-review"

usage() {
  cat <<'EOF'
claude-tmux - tmux × Claude Code 並列エージェント管理（オーケストレーション対応）

Usage:
  claude-tmux spawn "タスク説明"  [--name NAME] [--dir DIR] [--no-review] [--worktree]
  claude-tmux issues [--worktree] 42 43 44
  claude-tmux status
  claude-tmux agents
  claude-tmux wait <name> --until <idle|blocked|busy> [--timeout 秒] [--interval 秒]
  claude-tmux logs <name>
  claude-tmux kill [name|all]
  claude-tmux clean

Subcommands:
  spawn      新しいtmuxウィンドウで監督+作業者ペインを起動（実装後に自動レビュー）
             --worktree で専用 git worktree (agent/<name> ブランチ) を作成して作業。
             worktree モードでは完了後に監督が独立レビュアーで差分を検証し、
             指摘があれば修正エージェントを自動再投入する（最大2周、--no-review で無効）
  issues     複数のGitHub Issueを並列エージェントで処理
  status     spawn したエージェントのライフサイクル（running/completed 等）とペイン生存確認
  agents     tmux 上の全 Claude セッションの実行状態（busy/idle/blocked）を一覧
  wait       指定セッションが目的の状態になるまでブロックして待つ。
             blocked は「AskUserQuestion や許可待ちで人間の入力を待っている」状態。
             harness の status は busy/idle しか持たないため、フックで補っている
  logs       特定エージェントのログを less で表示
  kill       エージェントペイン停止とディレクトリ削除
  clean      完了/死亡したエージェントのディレクトリをクリーンアップ

Note:
  エージェントはインタラクティブモードでペイン分割実行されます。
  作業者の質問は Claude Code の Cross-session messaging (SendMessage) で
  spawn を実行したセッションに直接届きます。
  意図しないファイル変更のリスクがあるため、実行後に git diff で変更内容を確認してください。
EOF
}

require_tmux() {
  if [[ -z "${TMUX:-}" ]]; then
    echo "Error: tmuxセッション内で実行してください" >&2
    exit 1
  fi
}

ensure_agents_dir() {
  mkdir -p "$AGENTS_DIR"
}

get_agent_dir() {
  local name="$1"
  echo "${AGENTS_DIR}/${name}"
}

is_pane_alive() {
  local pane_id="$1"
  tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -q "^${pane_id}$"
}

SESSIONS_DIR="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
BLOCKED_OPT="${CLAUDE_AGENT_STATUS_OPT:-@claude_blocked}"

# harness が持つセッションレジストリから tmux 上のセッションを列挙する。
# "name<TAB>ペインID<TAB>status" を返す。tmux 外のセッション(デスクトップアプリ経由)は
# tmux が null なので落ちる。
#
# status は null になることがある。spawn した作業者(claude -p)がこれで、
# ペイン紐付けはされるが harness が busy/idle を書かない(実測)。
# 落とすと作業者が一覧から消えてしまうので unknown として残し、
# blocked の重ね合わせとペイン生存判定だけは効かせる。
list_registry_sessions() {
  command -v jq >/dev/null 2>&1 || return 0
  local f
  for f in "$SESSIONS_DIR"/*.json; do
    [[ -f "$f" ]] || continue
    jq -r 'select(.tmux != null)
           | [(.name // "?"), (.tmux | split(".") | last), (.status // "unknown")] | @tsv' \
      "$f" 2>/dev/null || true
  done
}

# レジストリの status(busy/idle)に、agent-status.sh が書いた blocked を重ねて実効状態を出す。
# レジストリ側は AskUserQuestion や許可待ちで停止中も busy のままになるため、
# 「働いている」と「人を待っている」はこの合成でしか区別できない。
agent_activity() {
  local pane="$1" status="$2"

  if ! is_pane_alive "$pane"; then
    echo "dead"
    return 0
  fi

  # harness 自身が "waiting"(人間の入力待ち)を返すことがある。
  # ただし AskUserQuestion 表示中でも busy のままだった実測例があるため、
  # harness の waiting とフックの blocked のどちらか一方でも立てば blocked とする。
  if [[ "$status" == "waiting" ]]; then
    echo "blocked"
    return 0
  fi

  # blocked はペインが生きている間だけ有効。値は blocked になった epoch 秒。
  local blocked
  blocked=$(tmux show-options -p -v -t "$pane" "$BLOCKED_OPT" 2>/dev/null || true)
  if [[ -n "$blocked" ]]; then
    echo "blocked"
    return 0
  fi

  echo "$status"
}

# 名前からレジストリ行を引く。見つからなければ空。
find_registry_line() {
  local name="$1"
  list_registry_sessions | awk -F'\t' -v n="$name" '$1 == n { print; exit }'
}

# spawn を実行した Claude セッションの名前。作業者はこの名前宛に SendMessage で質問する。
# Claude Code の Bash ツール経由で起動されたときだけ解決でき、素の端末から実行した場合は
# 空になる（そのときは作業者に質問経路を渡さず、自律判断で進ませる）。
resolve_hub_session_name() {
  local registry="${HOME}/.claude/sessions/${CLAUDE_PID:-}.json"
  if [[ -z "${CLAUDE_PID:-}" ]] || [[ ! -f "$registry" ]] || ! command -v jq >/dev/null 2>&1; then
    return 0
  fi
  jq -r '.name // empty' "$registry" 2>/dev/null || true
}

# spawn: 新しいtmuxウィンドウで監督+作業者ペインを起動
cmd_spawn() {
  require_tmux
  ensure_agents_dir

  local name=""
  local dir=""
  local prompt=""
  local no_review="false"
  local use_worktree="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        name="$2"
        shift 2
        ;;
      --dir)
        dir="$2"
        shift 2
        ;;
      --no-review)
        no_review="true"
        shift
        ;;
      --worktree)
        use_worktree="true"
        shift
        ;;
      *)
        if [[ -z "$prompt" ]]; then
          prompt="$1"
        else
          prompt="$prompt $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$prompt" ]]; then
    echo "Error: タスク説明を指定してください" >&2
    echo "Usage: claude-tmux spawn \"タスク説明\" [--name NAME] [--dir DIR]" >&2
    exit 1
  fi

  if [[ -z "$name" ]]; then
    name="agent-$(date +%s)"
  fi

  local work_dir="${dir:-$(pwd)}"
  local agent_dir="$(get_agent_dir "$name")"

  # エージェントディレクトリ作成
  mkdir -p "$agent_dir"

  # --worktree: 専用 worktree を作成し、作業ディレクトリを差し替える。
  # 同一ファイルを触るタスクを並列実行しても衝突しないようにするため。
  local worktree_note=""
  if [[ "$use_worktree" == "true" ]]; then
    local repo_root
    repo_root=$(git -C "$work_dir" rev-parse --show-toplevel 2>/dev/null) || {
      echo "Error: --worktree は git リポジトリ内でのみ使用できます" >&2
      rm -rf "$agent_dir"
      exit 1
    }
    local wt_branch="agent/${name}"
    local wt_path
    wt_path=$(cd "$work_dir" && git-wt add "$wt_branch") || {
      echo "Error: worktree の作成に失敗しました (branch: ${wt_branch})" >&2
      rm -rf "$agent_dir"
      exit 1
    }
    work_dir="$wt_path"
    echo "$wt_path" > "${agent_dir}/worktree-path"
    echo "$repo_root" > "${agent_dir}/repo-root"
    # 外部レビューの差分基点。worktree 作成直後の HEAD = ブランチの開始点
    git -C "$wt_path" rev-parse HEAD > "${agent_dir}/base-commit"
    worktree_note="

【worktree での作業】
- あなたは専用の git worktree（ブランチ: ${wt_branch}）で作業しています
- 実装が完了したら変更を必ずコミットしてください（コミット規約はリポジトリの CLAUDE.md に従う）
- メインブランチへのマージは人間が行うため、push・マージ・ブランチ切替はしないでください"
  fi

  # プロンプトファイル作成
  local prompt_file="${agent_dir}/prompt"
  printf '%s' "$prompt" > "$prompt_file"

  # 質問経路は spawn 元のセッションが特定できるときだけ渡す
  local hub_name
  hub_name=$(resolve_hub_session_name)
  local question_note=""
  if [[ -n "$hub_name" ]]; then
    question_note="

【質問がある場合】
- どうしても判断に迷う場合のみ、SendMessage ツールで \"${hub_name}\" 宛に質問を送ってください
- 初回送信は名前だけだと確認を求めるエラーになります。エラー文に出る \"${hub_name} [ref]\" の形式でそのまま送り直してください（ref が分からなければ ListAgents で確認）
- 送信後は返信を待たず、依存しない作業を先に進めてください。返信は会話に自動で届きます
- ファイルやポーリングでのやりとりは不要です"
  fi

  # 拡張プロンプト作成
  local enhanced_prompt="${prompt}

---

【重要】自律的な実装について：

このタスクは自動実行モードで実行されています。以下のルールに従ってください：
- ユーザーに質問せず、最善の判断で実装を進めてください
- 技術選択が必要な場合は、一般的でメンテナンス性の高い選択を優先してください
- セキュリティとシンプルさを重視してください${worktree_note}

【実装完了後のレビューループ】$(if [[ "${no_review}" == "true" ]]; then echo "
※ レビューはスキップしてください。実装完了後、/exit で終了してください。"; else echo "
実装が完了したら、以下のループを実行してください：
1. /code-review スキルを実行してコードレビューを行う
2. 指摘事項がある場合は修正を実施する
3. 修正後、再度 /code-review を実行する
4. 指摘事項がなくなるまで 2-3 を繰り返す（最大3回）
5. レビュー結果（最終）を Write ツールで ${agent_dir}/review-result に書き込む
6. 完了したら /exit で終了する"; fi)${question_note}"

  # プロンプトファイル作成
  echo "$enhanced_prompt" > "${agent_dir}/enhanced_prompt"

  # 作業者ラッパースクリプトを作成
  local runner_script="${agent_dir}/runner.sh"
  cat > "$runner_script" <<RUNNER
#!/usr/bin/env bash
name="${name}"
agent_dir="${agent_dir}"
prompt_file="\${agent_dir}/enhanced_prompt"

echo "=== 作業者: \${name} ==="
echo "Dir: \$(pwd)"
echo "---"

# プロンプトは stdin で渡す。--allowedTools は可変長オプションのため、
# 後続の位置引数をプロンプトとして置くと飲み込まれてしまう。
# --name は spawn 元が SendMessage の宛先に使う。crossSessionInbound=accept は必須で、
# -p セッションは承認ダイアログを出せず、既定のまま hold されると返信が永久に届かない。
claude -p --name "\${name}" --settings '{"crossSessionInbound":"accept"}' \\
  --allowedTools "Edit,Write,Read,Grep,Glob,Bash,WebSearch,WebFetch,SendMessage,ListAgents" < "\${prompt_file}"

echo "completed" > "\${agent_dir}/status"
echo ""
echo "=== 完了 ==="
RUNNER
  chmod +x "$runner_script"

  # 監督スクリプトを作成
  local supervisor_script="${agent_dir}/supervisor.sh"
  cat > "$supervisor_script" <<SUPERVISOR
#!/usr/bin/env bash
name="${name}"
agent_dir="${agent_dir}"
worker_pane_id_file="\${agent_dir}/worker-pane-id"

echo "=== 監督: \${name} ==="
echo "作業者の完了を監視中..."
echo ""

while true; do
  # 作業者の完了確認（statusファイル or ペイン消失）
  if [[ -f "\${agent_dir}/status" ]] && [[ "\$(cat "\${agent_dir}/status")" == "completed" ]]; then
    echo ""
    echo "=== 作業者が完了しました ==="
    break
  fi
  if [[ -f "\${worker_pane_id_file}" ]]; then
    worker_pane=\$(cat "\${worker_pane_id_file}")
    if ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -q "^\${worker_pane}\\\$"; then
      echo ""
      echo "=== 作業者が終了しました ==="
      echo "completed" > "\${agent_dir}/status"
      break
    fi
  fi

  # レビュー結果の検出
  review_file="\${agent_dir}/review-result"
  if [[ -f "\${review_file}" ]] && [[ ! -f "\${agent_dir}/review-notified" ]]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📝 コードレビュー結果"
    echo ""
    cat "\${review_file}"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    touch "\${agent_dir}/review-notified"
  fi

  sleep 3
done

# 外部レビューループ: worktree モードでは作業者とは別の独立レビュアーで差分を検証し、
# 指摘があれば修正エージェントを再投入する(作業者の自己レビューとは別の独立した目)
if [[ "${use_worktree}" == "true" && "${no_review}" != "true" ]]; then
  wt="${work_dir}"
  base=\$(cat "\${agent_dir}/base-commit" 2>/dev/null || true)
  round=1
  max_rounds=2
  while [[ -n "\${base}" && \${round} -le \${max_rounds} ]]; do
    diff=\$(git -C "\${wt}" diff "\${base}" 2>/dev/null | head -c 50000)
    untracked=\$(git -C "\${wt}" ls-files --others --exclude-standard 2>/dev/null)
    if [[ -z "\${diff}" && -z "\${untracked}" ]]; then
      echo "変更がないため外部レビューをスキップします"
      break
    fi
    echo ""
    echo "=== 外部レビュー (\${round}/\${max_rounds}) ==="
    echo "reviewing" > "\${agent_dir}/status"
    review_prompt="\${agent_dir}/review-prompt"
    {
      echo "あなたは独立したコードレビュアーです。以下の変更をレビューしてください。"
      echo "- カレントディレクトリで Read/Grep/Glob を使って周辺コードを確認できます"
      echo "- バグ・セキュリティ・リポジトリ規約(CLAUDE.md)違反など重大な問題のみ指摘してください。軽微なスタイル指摘は不要です"
      echo "- 最終行に必ず「VERDICT: LGTM」(問題なし)または「VERDICT: FIX」(要修正)とだけ書いてください"
      echo ""
      if [[ -n "\${untracked}" ]]; then
        echo "--- 未追跡ファイル(必要なら Read で確認) ---"
        echo "\${untracked}"
        echo ""
      fi
      echo "--- 変更差分 ---"
      printf '%s\n' "\${diff}"
    } > "\${review_prompt}"
    review=\$(cd "\${wt}" && claude -p --allowedTools "Read,Grep,Glob" < "\${review_prompt}" 2>&1) || {
      echo "警告: 外部レビューの実行に失敗しました。人間が確認してください" >&2
      break
    }
    printf '%s' "\${review}" > "\${agent_dir}/external-review"
    echo "\${review}"
    verdict=\$(printf '%s' "\${review}" | grep -Eo 'VERDICT: ?(LGTM|FIX)' | tail -1)
    case "\${verdict}" in
      *LGTM)
        echo "✅ 外部レビュー: LGTM"
        break
        ;;
      *FIX)
        if [[ \${round} -ge \${max_rounds} ]]; then
          echo "⚠️ レビュー上限(\${max_rounds}周)に達しました。残りの指摘は人間が確認してください: \${agent_dir}/external-review"
          break
        fi
        echo "🔧 指摘があるため修正エージェントを再投入します"
        echo "fixing" > "\${agent_dir}/status"
        fix_prompt="\${agent_dir}/fix-prompt"
        {
          echo "外部コードレビューで以下の指摘がありました。修正し、変更をコミットしてください(コミット規約はリポジトリの CLAUDE.md に従う)。"
          echo "ユーザーへの質問はできません。最善の判断で対応してください。push・マージ・ブランチ切替はしないでください。"
          echo ""
          printf '%s\n' "\${review}"
        } > "\${fix_prompt}"
        (cd "\${wt}" && claude -p --allowedTools "Edit,Write,Read,Grep,Glob,Bash,WebSearch,WebFetch" < "\${fix_prompt}") || {
          echo "警告: 修正エージェントの実行に失敗しました" >&2
          break
        }
        round=\$((round + 1))
        ;;
      *)
        echo "⚠️ レビュー結果から VERDICT を判定できませんでした。人間が確認してください"
        break
        ;;
    esac
  done
  echo "completed" > "\${agent_dir}/status"
fi

echo ""
say "エージェント \${name} が終了しました"
sleep 3

# ウィンドウを自動で閉じる
window_name_file="\${agent_dir}/window-name"
if [[ -f "\${window_name_file}" ]]; then
  wname=\$(cat "\${window_name_file}")
  tmux kill-window -t "\${wname}" 2>/dev/null
fi
SUPERVISOR
  chmod +x "$supervisor_script"

  # 新しいウィンドウを作成して作業者を起動
  local window_name="${AGENT_PREFIX}${name}"
  local worker_pane_id
  worker_pane_id=$(tmux new-window -n "$window_name" -c "$work_dir" -P -F '#{pane_id}' "$runner_script")

  # 監督ペインを左側に追加（35%幅）
  local supervisor_pane_id
  supervisor_pane_id=$(tmux split-window -hb -l 35% -t "$worker_pane_id" -c "$work_dir" -P -F '#{pane_id}' "$supervisor_script")

  # メタデータ保存
  echo "$window_name" > "${agent_dir}/window-name"
  echo "$worker_pane_id" > "${agent_dir}/worker-pane-id"
  echo "$supervisor_pane_id" > "${agent_dir}/supervisor-pane-id"
  echo "running" > "${agent_dir}/status"

  echo "Agent '${name}' を起動しました"
  echo "  作業者ペイン: ${worker_pane_id}"
  echo "  監督ペイン:   ${supervisor_pane_id}"
  echo "  Dir: ${agent_dir}"
}

# issues: 複数のGitHub Issueを並列エージェントで処理
cmd_issues() {
  require_tmux
  ensure_agents_dir

  local extra_args=()
  local issue_nums=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worktree|--no-review)
        extra_args+=("$1")
        shift
        ;;
      *)
        issue_nums+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#issue_nums[@]} -eq 0 ]]; then
    echo "Error: Issue番号を指定してください" >&2
    echo "Usage: claude-tmux issues [--worktree] 42 43 44" >&2
    exit 1
  fi

  for issue_num in "${issue_nums[@]}"; do
    local prompt="GitHub Issue #${issue_num} を gh issue view ${issue_num} で確認し、内容に基づいてタスクを遂行してください。"
    # bash 3.2 の set -u では空配列展開がエラーになるためガード付きで展開する
    cmd_spawn "$prompt" --name "issue-${issue_num}" ${extra_args[@]+"${extra_args[@]}"}
  done
}

# status: 実行中のエージェント一覧とペイン生存確認
cmd_status() {
  ensure_agents_dir

  local count=0

  echo "=== エージェント一覧 ==="
  echo ""

  for agent_dir in "$AGENTS_DIR"/*/; do
    if [[ ! -d "$agent_dir" ]]; then
      continue
    fi

    local name=$(basename "$agent_dir")
    local worker_pane_file="${agent_dir}/worker-pane-id"
    local supervisor_pane_file="${agent_dir}/supervisor-pane-id"
    local status_file="${agent_dir}/status"

    count=$((count + 1))

    echo "  ${AGENT_PREFIX}${name}"

    # 作業者ペイン生存確認
    if [[ -f "$worker_pane_file" ]]; then
      local worker_pane=$(cat "$worker_pane_file")
      if is_pane_alive "$worker_pane"; then
        echo "    作業者: ${worker_pane} (alive)"
      else
        echo "    作業者: ${worker_pane} (dead)"
        # 外部レビュー中(reviewing/fixing)は監督が状態を管理しているため上書きしない
        if [[ "$(cat "$status_file" 2>/dev/null)" == "running" ]]; then
          echo "completed" > "$status_file"
        fi
      fi
    else
      echo "    作業者: unknown"
    fi

    # 監督ペイン生存確認
    if [[ -f "$supervisor_pane_file" ]]; then
      local supervisor_pane=$(cat "$supervisor_pane_file")
      if is_pane_alive "$supervisor_pane"; then
        echo "    監督:   ${supervisor_pane} (alive)"
      else
        echo "    監督:   ${supervisor_pane} (dead)"
      fi
    fi

    # ステータス
    if [[ -f "$status_file" ]]; then
      local status=$(cat "$status_file")
      echo "    Status: ${status}"
    fi

    if [[ -f "${agent_dir}/worktree-path" ]]; then
      echo "    Worktree: $(cat "${agent_dir}/worktree-path")"
    fi

    echo "    Dir: ${agent_dir}"
    echo ""
  done

  if [[ $count -eq 0 ]]; then
    echo "エージェントはありません"
  fi
}

# clean: 完了/死亡したエージェントのディレクトリをクリーンアップ
cmd_clean() {
  ensure_agents_dir

  local cleaned=0

  for agent_dir in "$AGENTS_DIR"/*/; do
    if [[ ! -d "$agent_dir" ]]; then
      continue
    fi

    local name=$(basename "$agent_dir")
    local worker_pane_file="${agent_dir}/worker-pane-id"
    local should_clean=0

    if [[ -f "$worker_pane_file" ]]; then
      local worker_pane=$(cat "$worker_pane_file")
      if ! is_pane_alive "$worker_pane"; then
        should_clean=1
      fi
    else
      should_clean=1
    fi

    if [[ $should_clean -eq 1 ]]; then
      echo "クリーンアップ: ${name}"
      notify_remaining_worktree "$agent_dir"
      rm -rf "$agent_dir"
      cleaned=$((cleaned + 1))
    fi
  done

  if [[ $cleaned -eq 0 ]]; then
    echo "クリーンアップするエージェントはありません"
  else
    echo "${cleaned} 件のエージェントをクリーンアップしました"
  fi
}

# logs: 特定エージェントのログを less で表示
cmd_logs() {
  if [[ $# -eq 0 ]]; then
    echo "Error: エージェント名を指定してください" >&2
    echo "Usage: claude-tmux logs <name>" >&2
    exit 1
  fi

  local name="$1"
  local agent_dir="$(get_agent_dir "$name")"
  local log_file="${agent_dir}/log"

  if [[ ! -f "$log_file" ]]; then
    echo "Error: ログファイルが見つかりません: ${log_file}" >&2
    echo "Note: ログ機能は現在未実装です" >&2
    exit 1
  fi

  less +F "$log_file"
}

# kill: エージェントウィンドウ停止とディレクトリ削除
cmd_kill() {
  require_tmux

  if [[ $# -eq 0 ]]; then
    echo "Error: エージェント名または 'all' を指定してください" >&2
    echo "Usage: claude-tmux kill [name|all]" >&2
    exit 1
  fi

  local target="$1"

  if [[ "$target" == "all" ]]; then
    for agent_dir in "$AGENTS_DIR"/*/; do
      if [[ ! -d "$agent_dir" ]]; then
        continue
      fi

      local name=$(basename "$agent_dir")
      kill_agent_window "$agent_dir" "$name"
      notify_remaining_worktree "$agent_dir"
      rm -rf "$agent_dir"
    done
  else
    local agent_dir="$(get_agent_dir "$target")"

    if [[ ! -d "$agent_dir" ]]; then
      echo "Error: エージェント '${target}' が見つかりません" >&2
      exit 1
    fi

    kill_agent_window "$agent_dir" "$target"
    notify_remaining_worktree "$agent_dir"
    rm -rf "$agent_dir"
    echo "削除: ${agent_dir}"
  fi
}

# worktree はマージ判断を人間が行うため自動削除せず、後始末の方法を案内する
notify_remaining_worktree() {
  local agent_dir="$1"
  if [[ -f "${agent_dir}/worktree-path" ]]; then
    echo "  worktree は残っています: $(cat "${agent_dir}/worktree-path")"
    echo "  マージ後に 'git wt rm' または 'git wt clean' で削除してください"
  fi
}

# ウィンドウ単位でエージェントを停止するヘルパー
kill_agent_window() {
  local agent_dir="$1"
  local name="$2"
  local window_name_file="${agent_dir}/window-name"

  # ウィンドウ名でkill（両ペインまとめて停止）
  if [[ -f "$window_name_file" ]]; then
    local window_name=$(cat "$window_name_file")
    if tmux list-windows -F '#{window_name}' 2>/dev/null | grep -q "^${window_name}$"; then
      tmux kill-window -t "=${window_name}" 2>/dev/null || true
      echo "停止: ${name} (window: ${window_name})"
      return
    fi
  fi

  # フォールバック: 個別ペインをkill
  for pane_file in "${agent_dir}/worker-pane-id" "${agent_dir}/supervisor-pane-id"; do
    if [[ -f "$pane_file" ]]; then
      local pane_id=$(cat "$pane_file")
      if is_pane_alive "$pane_id"; then
        tmux kill-pane -t "$pane_id" 2>/dev/null || true
      fi
    fi
  done
  echo "停止: ${name}"
}

cmd_agents() {
  local found=0 name pane status act

  echo "=== Claude セッション（tmux 上）==="
  echo ""
  while IFS=$'\t' read -r name pane status; do
    [[ -n "$name" ]] || continue
    found=1
    act=$(agent_activity "$pane" "$status")
    printf '  %s%-24s %-8s %s\n' "$AGENT_PREFIX" "$name" "$act" "$pane"
  done < <(list_registry_sessions)
  echo ""

  if [[ $found -eq 0 ]]; then
    echo "  tmux に紐づく Claude セッションはありません。"
    echo "  (デスクトップアプリ経由のセッションはレジストリに tmux/status を持ちません)"
    echo ""
  fi
}

# 指定セッションが目的の状態になるまで待つ。ポーリングで足りる粒度なので依存を増やさない。
cmd_wait() {
  local name="" until_state="" timeout=300 interval=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --until)    until_state="${2:-}"; shift 2 ;;
      --timeout)  timeout="${2:-}"; shift 2 ;;
      --interval) interval="${2:-}"; shift 2 ;;
      -*) echo "Error: 不明なオプション '$1'" >&2; exit 1 ;;
      *)  name="$1"; shift ;;
    esac
  done

  if [[ -z "$name" ]] || [[ -z "$until_state" ]]; then
    echo "Usage: claude-tmux wait <name> --until <idle|blocked|busy> [--timeout 秒] [--interval 秒]" >&2
    exit 1
  fi
  case "$until_state" in
    idle | blocked | busy) ;;
    *) echo "Error: --until は idle / blocked / busy のいずれか（指定: ${until_state}）" >&2; exit 1 ;;
  esac

  local waited=0 line pane status act
  while :; do
    line=$(find_registry_line "$name")
    if [[ -z "$line" ]]; then
      echo "Error: セッション '${name}' が見つかりません（claude-tmux agents で一覧を確認）" >&2
      exit 1
    fi
    IFS=$'\t' read -r _ pane status <<<"$line"
    act=$(agent_activity "$pane" "$status")

    if [[ "$act" == "$until_state" ]]; then
      echo "$act"
      return 0
    fi
    # ペインが消えたら永遠に到達しないので待ち続けない
    if [[ "$act" == "dead" ]]; then
      echo "Error: '${name}' のペイン ${pane} が消滅しました" >&2
      exit 2
    fi
    if (( waited >= timeout )); then
      echo "Error: timeout (${timeout}秒) — '${name}' は現在 ${act}" >&2
      exit 3
    fi

    sleep "$interval"
    waited=$((waited + interval))
  done
}

# tmux の status-right に埋め込む1セグメントを組み立てる。
# status-interval ごと(既定2秒)に呼ばれるので、tmux への問い合わせは list-panes 1回に
# まとめ、セッションごとに show-options を叩かない。
#
# 各セッションを "記号+名前" で1つずつ並べる。blocked を先頭に固めるので、
# 人を待たせているものが常に同じ位置(左端)に出る。
# 名前は 14 桁で切る。tmux のステータスバーは1行しかなく、右側には既に
# ネット速度・CPU/RAM・日時が載っているため。
cmd_statusline() {
  command -v jq >/dev/null 2>&1 || return 0
  command -v tmux >/dev/null 2>&1 || return 0

  # "<ペインID> <blockedの値>" を一括取得。オプション未設定なら第2フィールドは空になる。
  # ここに出ないペインは死んでいる。
  local panes
  panes=$(tmux list-panes -a -F '#{pane_id} #{@claude_blocked}' 2>/dev/null || true)
  [[ -n "$panes" ]] || return 0

  # 他のセグメントが区切りに使っている色に合わせる。背景を指定しないと
  # status-style の既定(緑)が透けて読めなくなる
  local BAR_BG="#1e1e2e"

  local G_BLOCKED G_BUSY G_IDLE G_UNKNOWN ELLIPSIS
  G_BLOCKED=$(printf '\xe2\x8f\xb8')   # ⏸
  G_BUSY=$(printf '\xe2\x96\xb6')      # ▶
  G_IDLE=$(printf '\xe2\x9c\x93')      # ✓
  G_UNKNOWN=$(printf '\xc2\xb7')       # ·
  ELLIPSIS=$(printf '\xe2\x80\xa6')    # …

  local out_blocked="" out_busy="" out_idle="" name pane status flag short
  while IFS=$'\t' read -r name pane status; do
    [[ -n "$name" ]] || continue
    flag=$(printf '%s\n' "$panes" \
      | awk -v p="$pane" '$1 == p { print ($2 == "" ? "free" : "blocked"); found = 1 }
                          END { if (!found) print "dead" }')
    [[ "$flag" == "dead" ]] && continue

    short=$(printf '%s' "$name" \
      | awk -v e="$ELLIPSIS" '{ if (length($0) > 14) print substr($0, 1, 13) e; else print }')

    # harness の waiting とフックの blocked のどちらでも「人待ち」とみなす
    if [[ "$flag" == "blocked" ]] || [[ "$status" == "waiting" ]]; then
      out_blocked+="#[fg=#f38ba8 bg=${BAR_BG} bold]${G_BLOCKED}${short} "
      continue
    fi
    case "$status" in
      busy) out_busy+="#[fg=#89b4fa bg=${BAR_BG}]${G_BUSY}${short} " ;;
      idle) out_idle+="#[fg=#9399b2 bg=${BAR_BG}]${G_IDLE}${short} " ;;
      *)    out_idle+="#[fg=#6c7086 bg=${BAR_BG}]${G_UNKNOWN}${short} " ;;
    esac
  done < <(list_registry_sessions)

  local all="${out_blocked}${out_busy}${out_idle}"
  [[ -n "$all" ]] || return 0

  # 末尾で明示的に戻す。#[default] は status-style(tmux 既定は緑)に戻ってしまい、
  # 背景を指定していない要素が緑地に乗って読めなくなる
  printf '#[bg=%s]%s#[fg=default bg=%s]' "$BAR_BG" "$all" "$BAR_BG"
}

# メインルーティング
case "${1:-}" in
  spawn)
    shift
    cmd_spawn "$@"
    ;;
  issues)
    shift
    cmd_issues "$@"
    ;;
  status)
    cmd_status
    ;;
  agents)
    cmd_agents
    ;;
  statusline)
    cmd_statusline
    ;;
  wait)
    shift
    cmd_wait "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  kill)
    shift
    cmd_kill "$@"
    ;;
  clean)
    cmd_clean
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "Error: 不明なサブコマンド '$1'" >&2
    usage
    exit 1
    ;;
esac
