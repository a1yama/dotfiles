#!/usr/bin/env bash
# claude-loop — リポジトリごとの改善ループを、専用マシンで無人の定時実行にする。
#
# なぜ専用の実行器が要るか:
#   - 定時実行は人が見ていない。常駐の対話セッションと同じ作業ツリーで動かすと、
#     互いの変更を踏む(同じ repo の別セッションが互いを知らずに同じ作業をした実例がある)。
#     ループは専用の git worktree で動かし、対話セッションの作業ツリーには触らない。
#   - 前回の変更が残った作業ツリーを黙って捨てない。失敗の痕跡なので、止めて知らせる。
#   - 設定は dotfiles で全マシンに配られる。HOST が一致するマシンでしか動かさない。
#
# 使い方:
#   claude-loop list                 設定されているループと直近の結果
#   claude-loop doctor               このマシンで無人実行を続けるのに足りない設定を点検する
#   claude-loop run <name>           1回実行(launchd から呼ばれる)
#   claude-loop run <name> --dry-run 準備までを確かめ、Claude は起動しない
#   claude-loop install              このマシン向けのループを launchd に登録
#   claude-loop uninstall            登録を外す
#   claude-loop render <name>        launchd の plist を標準出力に出す
#
# 設定: ~/.config/claude-loop/<name>.conf (KEY=VALUE。1行1項目)
#   REPO=~/ghq/github.com/owner/repo   対話用の clone(worktree の親。ここでは作業しない)
#   PROMPT=...                         Claude に渡す指示(1行)
#   HOST=Macmini                       実行してよいマシン(hostname -s)。必須
#   HOUR=6 / MINUTE=40                 毎日の起動時刻
#   WEEKDAY=1                          任意。指定した曜日だけ(0=日 … 6=土)
#   TIMEOUT_MIN=90                     任意。超えたら止める
#   BASE=origin/main                   任意。毎回この位置から始める
#   LINKS=.env .note-session           任意。対話用 clone から symlink する git 管理外のファイル
#   SETUP=npm ci                       任意。Claude の前に worktree で実行する準備コマンド
#   ENABLED=0                          任意。0 なら登録も実行もしない
#   NO_PUSH=1                          任意。1 なら Claude からの git push を止める(commit までのループ用)
#
# 通知: ~/.config/claude-loop/env に CLAUDE_SLACK_WEBHOOK_URL= / CLAUDE_DISCORD_WEBHOOK_URL= を書く。
# 認証: 同じファイルに CLAUDE_CODE_OAUTH_TOKEN=(`claude setup-token` の出力)を書くと claude に渡る。
#   launchd から起動したシェルは .zshrc を読まないので、対話シェル用に設定した環境変数は届かない。
#   このファイルは秘密の値を含むので dotfiles には入れない(マシンごとに手で置く)。
set -uo pipefail

# launchd の環境には対話シェルの PATH が無い。claude / git / node が見つからないまま
# 毎日失敗し続けるのを避けるため、ここで補う。
# 後ろに足す。前に足すと、呼び出し側が PATH の先頭に置いたもの(テストの偽コマンドなど)より
# こちらが優先され、テストから本物の claude が起動する(2026-11-22 に実際に起きた)
PATH="$PATH:${CLAUDE_LOOP_EXTRA_PATH-/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$HOME/.local/bin}"
export PATH
export GIT_TERMINAL_PROMPT=0

CONF_DIR="${CLAUDE_LOOP_CONF_DIR:-$HOME/.config/claude-loop}"
STATE_DIR="${CLAUDE_LOOP_STATE_DIR:-$HOME/.local/state/claude-loop}"
AGENTS_DIR="${CLAUDE_LOOP_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
LABEL_PREFIX="local.claude-loop"
SELF="${CLAUDE_LOOP_SELF:-$HOME/.local/bin/claude-loop}"

PREPARE_TIMEOUT_SEC="${CLAUDE_LOOP_PREPARE_TIMEOUT_SEC:-900}"
KILL_GRACE_SEC="${CLAUDE_LOOP_KILL_GRACE_SEC:-30}"

die() { printf 'claude-loop: %s\n' "$*" >&2; exit 1; }

# 通知先と無人実行用の認証トークンだけを env ファイルから読む。source しない(設定の読み取りと同じ理由)
# 対話ログインは期限で切れる。`claude setup-token` の長期トークンを渡せば launchd からでも動き続ける
load_env_file() {
  local file="$CONF_DIR/env" line key value
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    # `export KEY="値"` の書き方でも読めるようにする。引用符ごと URL にすると送信だけが黙って失敗する
    line="${line#export }"
    key="${line%%=*}" value="${line#*=}"
    # 行末の空白と CR も URL に混ざると送信だけが黙って失敗する
    value="${value%$'\r'}"; value="${value%"${value##*[![:space:]]}"}"
    value="${value#[\"\']}"; value="${value%[\"\']}"
    case "$key" in
      CLAUDE_SLACK_WEBHOOK_URL|CLAUDE_DISCORD_WEBHOOK_URL) export "$key=$value" ;;
      # export しない。SETUP(依存インストールのスクリプト)や git フックにまで長期トークンが渡るため
      CLAUDE_CODE_OAUTH_TOKEN) LOOP_OAUTH_TOKEN="$value" ;;
    esac
  done < "$file"
}
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
this_host() { hostname -s; }

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

list_names() {
  local f
  [ -d "$CONF_DIR" ] || return 0
  for f in "$CONF_DIR"/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf
  done
}

# 設定を読む。source しない(設定ファイルに書かれた任意のコードを実行しないため)。
# 知らないキーは打ち間違いとして止める。黙って無視すると、効かない設定のまま動き続ける。
load_conf() {
  local name="$1" file="$CONF_DIR/$1.conf" line key value
  valid_name "$name" || die "ループ名は英小文字・数字・ハイフンのみ: $name"
  [ -f "$file" ] || die "設定がありません: $file"
  REPO="" PROMPT="" HOST="" HOUR="" MINUTE="" WEEKDAY="" TIMEOUT_MIN="90"
  BASE="origin/main" LINKS="" SETUP="" ENABLED="1" NO_PUSH="0"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ "$line" == *=* ]] || die "$file: KEY=VALUE の形ではありません: $line"
    key="${line%%=*}" value="${line#*=}"
    case "$key" in
      REPO|PROMPT|HOST|HOUR|MINUTE|WEEKDAY|TIMEOUT_MIN|BASE|LINKS|SETUP|ENABLED|NO_PUSH)
        printf -v "$key" '%s' "$value" ;;
      *) die "$file: 不明なキーです: $key" ;;
    esac
  done < "$file"
  REPO="${REPO/#\~/$HOME}"
  [ -n "$REPO" ] || die "$file: REPO がありません"
  [ -n "$PROMPT" ] || die "$file: PROMPT がありません"
  # HOST を省略可にすると、dotfiles を入れた全マシンで同じループが動いてしまう
  [ -n "$HOST" ] || die "$file: HOST がありません(実行してよいマシンの hostname -s)"
  [[ "$HOUR" =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || die "$file: HOUR は 0〜23: $HOUR"
  [[ "$MINUTE" =~ ^([0-9]|[1-5][0-9])$ ]] || die "$file: MINUTE は 0〜59: $MINUTE"
  [[ -z "$WEEKDAY" || "$WEEKDAY" =~ ^[0-6]$ ]] || die "$file: WEEKDAY は 0〜6: $WEEKDAY"
  [[ "$TIMEOUT_MIN" =~ ^[1-9][0-9]*$ ]] || die "$file: TIMEOUT_MIN は正の整数: $TIMEOUT_MIN"
  [[ "$ENABLED" == "0" || "$ENABLED" == "1" ]] || die "$file: ENABLED は 0 か 1: $ENABLED"
  [[ "$NO_PUSH" == "0" || "$NO_PUSH" == "1" ]] || die "$file: NO_PUSH は 0 か 1: $NO_PUSH"
}

xml_escape() {
  local s="$1"
  s="${s//&/&amp;}"; s="${s//</&lt;}"; s="${s//>/&gt;}"
  printf '%s' "$s"
}

render_plist() {
  local name="$1" weekday_xml=""
  load_conf "$name"
  [ -n "$WEEKDAY" ] && weekday_xml="
    <key>Weekday</key><integer>$WEEKDAY</integer>"
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL_PREFIX.$name</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec $(xml_escape "$SELF") run $name</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>$HOUR</integer>
    <key>Minute</key><integer>$MINUTE</integer>$weekday_xml
  </dict>
  <key>StandardOutPath</key><string>$(xml_escape "$STATE_DIR/logs/$name.launchd.log")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$STATE_DIR/logs/$name.launchd.log")</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
PLIST
}

notify() {
  # 通知先が無くても実行は止めない。結果は必ず <name>.last.json に残っている
  local text="$1" payload
  command -v curl >/dev/null 2>&1 || return 0
  payload=$(printf '%s' "$text" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null) || return 0
  if [ -n "${CLAUDE_SLACK_WEBHOOK_URL:-}" ]; then
    curl -s -m 10 -X POST -H 'Content-Type: application/json' \
      -d "{\"text\":$payload}" "$CLAUDE_SLACK_WEBHOOK_URL" >/dev/null 2>&1 || true
  fi
  if [ -n "${CLAUDE_DISCORD_WEBHOOK_URL:-}" ]; then
    curl -s -m 10 -X POST -H 'Content-Type: application/json' \
      -d "{\"content\":$payload}" "$CLAUDE_DISCORD_WEBHOOK_URL" >/dev/null 2>&1 || true
  fi
}

write_result() {
  local name="$1" status="$2" detail="$3" started="$4" logfile="$5"
  mkdir -p "$STATE_DIR"
  python3 - "$STATE_DIR/$name.last.json" "$name" "$status" "$detail" "$started" "$logfile" <<'PY'
import json, sys, time
path, name, status, detail, started, logfile = sys.argv[1:7]
json.dump({"name": name, "status": status, "detail": detail, "started": started,
           "finished": time.strftime("%Y-%m-%d %H:%M:%S"), "log": logfile},
          open(path, "w"), ensure_ascii=False, indent=2)
PY
}

# 作業ツリーに残った変更を返す。LINKS で張った symlink は「前回の変更」ではないので除く
leftover_changes() {
  local wt="$1" links="$2" line path keep link orphan
  set -f # LINKS の値をグロブ展開させない(launchd の作業ディレクトリは /)
  git -C "$wt" status --porcelain 2>/dev/null | while IFS= read -r line; do
    path="${line:3}"; path="${path%/}"; keep=1
    for link in $links; do [ "$path" = "$link" ] && keep=0; done
    [ "$keep" = "1" ] && printf '%s\n' "$line"
  done
  set +f
  # ブランチを切らずに detached HEAD へ積まれ、push もされていないコミット。
  # 次の checkout でどこからも参照されなくなるので、これも前回の変更として止める
  orphan=$(git -C "$wt" rev-list HEAD --not --remotes --branches 2>/dev/null | head -5)
  [ -n "$orphan" ] && printf '未 push のコミット(ブランチ無し): %s\n' $orphan
  return 0
}

prepare_worktree() {
  local name="$1" wt="$2" f leftover exclude
  [ -d "$REPO/.git" ] || [ -f "$REPO/.git" ] || { echo "REPO が git リポジトリではありません: $REPO"; return 1; }
  git -C "$REPO" fetch -q origin || { echo "git fetch に失敗しました"; return 1; }
  if [ ! -d "$wt" ]; then
    # ディレクトリだけ手で消されていると git 側の登録が残り、add が毎回失敗する
    git -C "$REPO" worktree prune
    mkdir -p "$(dirname "$wt")"
    git -C "$REPO" worktree add -q --detach "$wt" "$BASE" || { echo "worktree を作れません: $wt"; return 1; }
  fi
  leftover=$(leftover_changes "$wt" "$LINKS")
  if [ -n "$leftover" ]; then
    echo "前回の変更が作業ツリーに残っています。中身を確かめてから片付けてください: $wt"
    printf '%s\n' "$leftover" | head -20
    return 1
  fi
  git -C "$wt" checkout -q --detach "$BASE" || { echo "$BASE に切り替えられません"; return 1; }
  set -f
  for f in $LINKS; do
    [ -e "$REPO/$f" ] || { set +f; echo "LINKS の元がありません: $REPO/$f"; return 1; }
    if [ -e "$wt/$f" ] || [ -L "$wt/$f" ]; then
      # リンクが実ファイルに置き換わっていたり、REPO を変える前のリンクが残っていたりすると、
      # 古い認証情報を黙って使い続ける。残骸の検査は LINKS を除外するので、ここで確かめる
      [ -L "$wt/$f" ] && [ "$(readlink "$wt/$f")" = "$REPO/$f" ] \
        || { set +f; echo "LINKS の先が対話用 clone を指していません: $wt/$f"; return 1; }
    else
      # 親ディレクトリが git 管理外で worktree に無い場合などに失敗する。
      # 確かめないと、認証情報が無いまま Claude が動く
      ln -s "$REPO/$f" "$wt/$f" || { set +f; echo "LINKS を張れません: $wt/$f"; return 1; }
    fi
    # リンクを git から見えなくする。`dir/` の形の .gitignore は symlink に効かないので、
    # そのままだと未追跡として見え、無人実行が `git add -A` でリンクをコミットに含めうる
    exclude="$(cd "$wt" && cd "$(git rev-parse --git-common-dir)" && pwd)/info/exclude"
    mkdir -p "$(dirname "$exclude")"
    grep -qxF "/$f" "$exclude" 2>/dev/null || printf '/%s\n' "$f" >> "$exclude"
  done
  set +f
  # 環境変数で足した pushurl は既存の値を置き換えない。リポジトリ側に pushurl があると、
  # git は両方へ push するので、push の禁止が効かない
  if [ "$NO_PUSH" = "1" ] && [ -n "$(git -C "$REPO" config --get-all remote.origin.pushurl 2>/dev/null)" ]; then
    echo "NO_PUSH=1 ですが、origin に pushurl が設定されています。外してから実行してください: git -C $REPO config --unset-all remote.origin.pushurl"
    return 1
  fi
  if [ -n "$SETUP" ]; then
    (cd "$wt" && bash -c "$SETUP") || { echo "SETUP が失敗しました: $SETUP"; return 1; }
  fi
}

UNATTENDED_NOTE='これは無人の定時実行です。質問に答える人はいません。AskUserQuestion を使わず、確認が必要なことや判断できないことは実行せずに最終報告へ書いて終了してください。作業は現在の作業ツリー(専用の git worktree)の中だけで行ってください。'
NOTE_PR='変更はブランチを切って PR にしてください。'
NOTE_NO_PUSH='このループでは git push と PR の作成を禁じています(push は失敗するように設定してあります)。変更はローカルのブランチに commit するところまでにしてください。ブランチ名は必ず次の接頭辞で始めてください: '

# Claude とその子プロセスの git push を失敗させる。手順書に「push しない」と書くだけでは、
# 公開リポジトリへの反映を文面の解釈に預けることになる。
# 環境変数で渡すので、同じリポジトリを使う対話セッションの設定は変えない
block_push() {
  local i=0 prefix
  export GIT_CONFIG_KEY_0="remote.origin.pushurl" GIT_CONFIG_VALUE_0="no-push://claude-loop/"
  # origin 以外の宛先(URL の直書き)も止める
  for prefix in "https://" "http://" "ssh://" "git://" "git@" "file://" "/" "." "~"; do
    i=$((i + 1))
    export "GIT_CONFIG_KEY_$i=url.no-push://claude-loop/.pushInsteadOf" "GIT_CONFIG_VALUE_$i=$prefix"
  done
  # 宛先の書き換えは、宛先の書き方しだいで外れる。push の直前に必ず呼ばれる pre-push でも止める
  # (--no-verify で飛ばせるので、宛先の書き換えと両方を置く)
  local hooks="$STATE_DIR/no-push-hooks"
  mkdir -p "$hooks" && printf '#!/bin/sh\necho "claude-loop: このループでは push を禁じています" >&2\nexit 1\n' > "$hooks/pre-push" \
    && chmod +x "$hooks/pre-push" || exit 1
  i=$((i + 1))
  export "GIT_CONFIG_KEY_$i=core.hooksPath" "GIT_CONFIG_VALUE_$i=$hooks"
  export GIT_CONFIG_COUNT=$((i + 1))
}

# 制限時間つきで実行する。超えたらプロセスグループごと TERM し、猶予のあと KILL する。
#   $1: 制限秒 / $2: 出力先 / $3: 時間切れの目印ファイル / 残り: コマンド(シェル関数も可)
# TERM を1回送るだけだと、相手が終わらないとき wait が戻らず、ロックを握ったまま翌日以降の
# 実行を黙って止め続ける。Claude が起動した子プロセス(npm など)も取り残される。
run_limited() {
  local limit="$1" out="$2" marker="$3" pid watchdog sleeper rc
  shift 3
  rm -f "$marker"
  set -m # バックグラウンドのジョブを別のプロセスグループにする(グループごと止めるため)
  ( "$@" ) > "$out" 2>&1 &
  pid=$!
  set +m
  (
    trap 'kill "$sleeper" 2>/dev/null; exit 0' TERM
    sleep "$limit" & sleeper=$!; wait "$sleeper"
    # 目印を先に置く。kill の後だと、本体側の判定が先に走って「失敗」と記録される
    touch "$marker"
    kill -TERM -- "-$pid" 2>/dev/null
    sleep "$KILL_GRACE_SEC" & sleeper=$!; wait "$sleeper"
    kill -KILL -- "-$pid" 2>/dev/null
  ) &
  watchdog=$!
  # 別グループにしたので、launchd がこのスクリプトを止めても TERM は対象に届かない。
  # 伝えないと、対象が取り残されたままロックだけが外れ、次の回と同時に動く
  RUNNING_GROUP="$pid" RUNNING_WATCHDOG="$watchdog"
  trap on_interrupt TERM INT
  wait "$pid"; rc=$?
  trap - TERM INT
  kill -TERM "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
  return "$rc"
}

# 外から止められたとき(launchd の再登録、ログアウト)も、時間切れと同じ手順で終える。
# TERM を送っただけで抜けると、止まりきっていない対象を残したままロックが外れて次の回と重なり、
# 結果ファイルには前回の成功が残る
on_interrupt() {
  trap - TERM INT
  kill -TERM "$RUNNING_WATCHDOG" 2>/dev/null
  kill -TERM -- "-$RUNNING_GROUP" 2>/dev/null
  local waited=0
  while kill -0 -- "-$RUNNING_GROUP" 2>/dev/null && [ "$waited" -lt "$KILL_GRACE_SEC" ]; do
    sleep 1; waited=$((waited + 1))
  done
  kill -KILL -- "-$RUNNING_GROUP" 2>/dev/null
  wait 2>/dev/null
  write_result "$CURRENT_NAME" "interrupted" "実行中に外から停止されました" "$CURRENT_STARTED" "$CURRENT_LOG"
  notify "claude-loop [$CURRENT_NAME] interrupted: 実行中に外から停止されました"
  exit 143
}

# NO_PUSH のループが作るブランチの接頭辞。確認待ちを数えるために名前を決めておく
pending_prefix() { printf 'loop-%s/' "$1"; }

# push されずに確認を待っているブランチの数。NO_PUSH のループは成果が外から見えないので、
# 数えて結果に残し、通知する。そうしないと、作った改善にも、溜まって止まったことにも誰も気づかない
pending_branches() {
  git -C "$REPO" for-each-ref --no-merged "$BASE" --format='%(refname:short)' \
    "refs/heads/$(pending_prefix "$1")" 2>/dev/null | grep -c . || true
}

launch_claude() {
  cd "$1" || exit 1
  # 標準入力を閉じる。開いたままだと claude が入力を数秒待ってから始める
  [ -n "${LOOP_OAUTH_TOKEN:-}" ] && export CLAUDE_CODE_OAUTH_TOKEN="$LOOP_OAUTH_TOKEN"
  if [ "$NO_PUSH" = "1" ]; then
    block_push
    # git の設定で止められるのは git の経路だけ。gh と MCP からも GitHub へ書けるので、道具ごと外す
    exec claude -p "$PROMPT" --permission-mode auto --name "loop-$2" \
      --append-system-prompt "$UNATTENDED_NOTE$NOTE_NO_PUSH$(pending_prefix "$2")" --strict-mcp-config \
      --disallowedTools "Bash(git push *)" "Bash(gh *)" < /dev/null
  fi
  exec claude -p "$PROMPT" --permission-mode auto --name "loop-$2" \
    --append-system-prompt "$UNATTENDED_NOTE$NOTE_PR" < /dev/null
}

# ロックを取る。取れたら 0、前回が実行中なら 1
acquire_lock() {
  local name="$1" lock="$2" old age
  if mkdir "$lock" 2>/dev/null; then
    echo $$ > "$lock/pid"
    return 0
  fi
  old=$(cat "$lock/pid" 2>/dev/null || true)
  age=$(( $(date +%s) - $(stat -f %m "$lock" 2>/dev/null || stat -c %Y "$lock" 2>/dev/null || echo 0) ))
  # pid がまだ書かれていない直後のロックは、別の実行が取ったばかりのもの。古いロックと取り違えない
  if { [ -n "$old" ] && kill -0 "$old" 2>/dev/null; } || { [ -z "$old" ] && [ "$age" -lt 60 ]; }; then
    if [ "$age" -gt $((TIMEOUT_MIN * 120)) ]; then
      # 制限時間の2倍を超えても動いているのは異常。黙ってスキップし続けない
      write_result "$name" "stuck" "前回の実行(pid $old)が ${age}秒 動いたままです" "$(date '+%Y-%m-%d %H:%M:%S')" ""
      notify "claude-loop [$name] stuck: 前回の実行(pid $old)が ${age}秒 動いたままです"
    fi
    log "[$name] 前回の実行がまだ動いています(pid ${old:-不明})。今回は実行しません"
    return 1
  fi
  # 持ち主のいないロックは、前回が異常終了した跡。外して続ける。
  # 名前を変えてから消す。rename は同時に1つしか成功しないので、2つの実行が同じ古いロックを
  # 見つけても回収するのは片方だけになる(rm してから mkdir だと互いのロックを消し合う)
  mv "$lock" "$lock.stale.$$" 2>/dev/null || { log "[$name] 別の実行がロックを取りました。今回は実行しません"; return 1; }
  rm -rf "$lock.stale.$$"
  mkdir "$lock" 2>/dev/null || { log "[$name] ロックを取れません: $lock"; return 1; }
  echo $$ > "$lock/pid"
}

cmd_run() {
  local name="${1:-}" dry_run=0
  [ -n "$name" ] || die "使い方: claude-loop run <name> [--dry-run]"
  # 知らない引数を無視すると、--dryrun の打ち間違いで Claude が起動し、PR のマージまで進む
  if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [ "$2" != "--dry-run" ]; }; then
    die "不明な引数です: ${*:2} (使えるのは --dry-run だけ)"
  fi
  [ "${2:-}" = "--dry-run" ] && dry_run=1
  load_conf "$name"
  load_env_file
  [ "$ENABLED" = "1" ] || { log "[$name] ENABLED=0 のため実行しません"; return 0; }
  if [ "$(this_host)" != "$HOST" ]; then
    # launchd に登録されているのはこのマシン向けのループだけ。それでも名前が合わないのは、
    # ホスト名が変わった(macOS では接続先のネットワークで変わりうる)ということ。黙って止まらない
    log "[$name] このマシン($(this_host))は対象外です(HOST=$HOST)"
    write_result "$name" "skipped_host" "hostname -s が $(this_host) で、HOST=$HOST と一致しません" "$(date '+%Y-%m-%d %H:%M:%S')" ""
    notify "claude-loop [$name] skipped_host: hostname -s が $(this_host) で、HOST=$HOST と一致しません"
    return 0
  fi

  local lock="$STATE_DIR/$name.lock" wt="$STATE_DIR/worktrees/$name"
  local started logfile preplog rc=0 status detail missing="" c
  started=$(date '+%Y-%m-%d %H:%M:%S')
  logfile="$STATE_DIR/logs/$name/$(date '+%Y%m%d-%H%M%S').log"
  preplog="${logfile%.log}.prepare.log" # Claude の出力で上書きされないよう、準備の出力は別に残す
  CURRENT_NAME="$name" CURRENT_STARTED="$started" CURRENT_LOG="$logfile"
  mkdir -p "$STATE_DIR/logs/$name"

  acquire_lock "$name" "$lock" || return 0
  # trap は関数を抜けた後(スクリプト終了時)に走る。local 変数は見えないのでグローバルに渡す
  LOCK_TO_RELEASE="$lock"
  trap 'rm -rf "$LOCK_TO_RELEASE"' EXIT

  # 必要なコマンドが無い環境(PATH の違うシェルからの起動)を、準備の失敗として記録に残す
  for c in claude git python3; do command -v "$c" >/dev/null 2>&1 || missing="$missing $c"; done
  if [ -n "$missing" ]; then
    detail="コマンドが見つかりません:$missing (PATH=$PATH)"
    rc=1
  else
    run_limited "$PREPARE_TIMEOUT_SEC" "$preplog" "$lock/timed_out" prepare_worktree "$name" "$wt"; rc=$?
    detail=$(cat "$preplog" 2>/dev/null)
    [ -f "$lock/timed_out" ] && detail="準備が ${PREPARE_TIMEOUT_SEC}秒 を超えたため停止しました
$detail"
  fi
  if [ "$rc" -ne 0 ]; then
    log "[$name] 準備に失敗: $detail"
    printf '%s\n' "$detail" > "$logfile"
    write_result "$name" "prepare_failed" "$detail" "$started" "$logfile"
    notify "claude-loop [$name] 準備に失敗しました: ${detail%%$'\n'*}"
    return 1
  fi

  if [ "$dry_run" = "1" ]; then
    log "[$name] --dry-run: 準備まで成功。Claude は起動しません($wt)"
    write_result "$name" "dry_run" "準備まで成功" "$started" "$logfile"
    return 0
  fi

  log "[$name] 開始: $wt"
  run_limited $((TIMEOUT_MIN * 60)) "$logfile" "$lock/timed_out" launch_claude "$wt" "$name"; rc=$?

  if [ -f "$lock/timed_out" ]; then
    status="timeout"; detail="${TIMEOUT_MIN}分を超えたため停止しました"
  elif [ "$rc" -eq 0 ]; then
    status="ok"; detail="正常終了"
  else
    status="failed"; detail="終了コード $rc"
  fi
  local pending=0
  if [ "$NO_PUSH" = "1" ]; then
    pending=$(pending_branches "$name")
    [ "$pending" -gt 0 ] && detail="${detail} / 確認待ちのブランチ ${pending}本 ($(pending_prefix "$name")*)"
  fi
  write_result "$name" "$status" "$detail" "$started" "$logfile"
  log "[$name] $status: $detail (ログ: $logfile)"
  if [ "$status" != "ok" ] || [ "$pending" -gt 0 ]; then
    notify "claude-loop [$name] $status: $detail (ログ: $logfile)"
  fi
  [ "$status" = "ok" ]
}

cmd_list() {
  local name last
  for name in $(list_names); do
    load_conf "$name"
    last="未実行"
    [ -f "$STATE_DIR/$name.last.json" ] && last=$(python3 -c '
import json,sys; d=json.load(open(sys.argv[1])); print(d["finished"], d["status"], d["detail"])' "$STATE_DIR/$name.last.json" 2>/dev/null || echo "結果を読めません")
    printf '%s\t%02d:%02d%s\tHOST=%s\tENABLED=%s\t%s\n' "$name" "$HOUR" "$MINUTE" \
      "${WEEKDAY:+ 曜日$WEEKDAY}" "$HOST" "$ENABLED" "$last"
  done
}

cmd_install() {
  local name plist uid target count=0
  uid=$(id -u)
  mkdir -p "$AGENTS_DIR" "$STATE_DIR/logs"
  # 設定を消した・改名したループの登録が残ると、毎日起動して「設定がありません」で失敗し続ける
  for plist in "$AGENTS_DIR/$LABEL_PREFIX".*.plist; do
    [ -f "$plist" ] || continue
    name=$(basename "$plist" .plist); name="${name#"$LABEL_PREFIX".}"
    [ -f "$CONF_DIR/$name.conf" ] && continue
    launchctl bootout "gui/$uid/$LABEL_PREFIX.$name" >/dev/null 2>&1 || true
    rm -f "$plist"
    log "[$name] 設定が無いので登録を外しました"
  done
  for name in $(list_names); do
    load_conf "$name"
    plist="$AGENTS_DIR/$LABEL_PREFIX.$name.plist"
    target="gui/$uid/$LABEL_PREFIX.$name"
    # 無効にした・別マシン向けにしたループは、登録が残らないよう必ず外す
    launchctl bootout "$target" >/dev/null 2>&1 || true
    if [ "$ENABLED" != "1" ] || [ "$(this_host)" != "$HOST" ]; then
      rm -f "$plist"
      log "[$name] 対象外(HOST=$HOST ENABLED=$ENABLED)。登録しません"
      continue
    fi
    render_plist "$name" > "$plist"
    # bootout の直後は登録が Input/output error で失敗することがある。1回だけ待って試し直す
    launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null \
      || { sleep 1; launchctl bootstrap "gui/$uid" "$plist"; } \
      || die "launchd への登録に失敗: $plist"
    log "[$name] 登録しました: 毎日 $(printf '%02d:%02d' "$HOUR" "$MINUTE")${WEEKDAY:+ (曜日 $WEEKDAY)}"
    count=$((count + 1))
  done
  log "登録 $count 件"
}

cmd_uninstall() {
  local plist uid label
  uid=$(id -u)
  for plist in "$AGENTS_DIR/$LABEL_PREFIX".*.plist; do
    [ -f "$plist" ] || continue
    label=$(basename "$plist" .plist)
    launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
    rm -f "$plist"
    log "外しました: $label"
  done
}

# このマシンで無人実行を続けるのに足りないものを点検する。人が手でやる設定(ホスト名の固定、通知先、
# 認証トークン、自動ログイン)は会話や記憶に頼ると抜けるので、機械で確かめられる形にしておく
cmd_doctor() {
  local bad=0 mine=0 name uid file perm fixed status detail pending user hosts="" target
  uid=$(id -u)
  d_ok() { printf 'OK      %s\n' "$1"; }
  d_ng() { printf '要対応  %s\n        → %s\n' "$1" "$2"; bad=1; }
  # マシン単位の設定。ループを動かさないマシン(普段使いの端末)では、足りなくても困らないので知らせるだけにする
  d_need() { if [ "$mine" -gt 0 ]; then d_ng "$1" "$2"; else printf '情報    %s\n' "$1"; fi; }

  # 先に、このマシン向けのループの数と、設定に書かれた HOST の一覧を数える。壊れた設定で点検を止めない
  for name in $(list_names); do
    ( load_conf "$name" ) >/dev/null 2>&1 || continue
    load_conf "$name"
    [ "$ENABLED" = "1" ] || continue
    case " $hosts " in *" $HOST "*) ;; *) hosts="$hosts $HOST" ;; esac
    [ "$(this_host)" = "$HOST" ] && mine=$((mine + 1))
  done
  hosts="${hosts# }"

  for name in claude git python3; do
    command -v "$name" >/dev/null 2>&1 && d_ok "コマンド $name" || d_ng "コマンド $name が見つかりません" "インストールするか PATH を確かめる"
  done

  if command -v scutil >/dev/null 2>&1; then
    fixed=$(scutil --get HostName 2>/dev/null || true)
    # 固定する名前は設定の HOST から出す。固定されていないときの hostname -s はネットワークが付けた
    # 名前かもしれず、それで固定させると、ずれた名前のまま全ループが対象外になる
    target="$(this_host)"
    if [ "$mine" -eq 0 ] && [ -n "$hosts" ]; then
      # 候補が複数あるときは選んでもらう。今の名前を固定先として出さない
      if [ "${hosts#* }" = "$hosts" ]; then target="$hosts"; else target="<次のどれか: ${hosts}>"; fi
    fi
    # HostName を FQDN で固定していても、hostname -s は先頭の部分だけを返す
    if [ -n "$fixed" ] && [ "${fixed%%.*}" = "$(this_host)" ]; then d_ok "ホスト名は固定されています(${fixed})"
    elif [ "$mine" -eq 0 ] && [ -n "$hosts" ]; then
      d_ng "ホスト名が固定されておらず、今の名前($(this_host))に合うループがありません。名前がずれている可能性があります(設定の HOST: ${hosts})" \
        "ここが専用マシンなら: sudo scutil --set HostName ${target}"
    else d_need "ホスト名が固定されていません(接続先のネットワークで変わり、全ループが止まります)" "sudo scutil --set HostName ${target}"; fi
  fi

  file="$CONF_DIR/env"
  if [ -f "$file" ]; then
    # GNU の stat は -f を「ファイルシステムの情報」と解釈し、何か出力してから失敗する。先に GNU の形を試す
    perm=$(stat -c %a "$file" 2>/dev/null) || perm=$(stat -f %Lp "$file" 2>/dev/null) || perm=""
    if [[ "$perm" =~ ^[0-7]+$ ]] && [ $(( 8#$perm & 8#077 )) -eq 0 ]; then d_ok "env ファイルは本人だけが読めます"
    else d_ng "env ファイルを他の利用者が読めます(権限 ${perm:-不明})" "chmod 600 $file"; fi
  fi
  # 対話シェルで export 済みの値を数えない。launchd はその環境を引き継がないので、
  # env ファイルに無ければ無人実行では届かない
  unset CLAUDE_SLACK_WEBHOOK_URL CLAUDE_DISCORD_WEBHOOK_URL LOOP_OAUTH_TOKEN
  load_env_file
  if [ -n "${CLAUDE_SLACK_WEBHOOK_URL:-}${CLAUDE_DISCORD_WEBHOOK_URL:-}" ]; then d_ok "通知先が設定されています"
  else d_need "通知先がありません(失敗にも、確認待ちのブランチにも気づけません)" "$file に CLAUDE_SLACK_WEBHOOK_URL=<URL> を1行書く"; fi
  if [ -n "${LOOP_OAUTH_TOKEN:-}" ]; then d_ok "無人実行用の認証トークンが設定されています"
  else d_need "認証トークンがありません(対話ログインの期限が切れると止まります)" "claude setup-token の出力を $file に CLAUDE_CODE_OAUTH_TOKEN=<値> で書き、chmod 600 する"; fi

  if command -v defaults >/dev/null 2>&1; then
    user=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null || true)
    if [ "$user" = "$(id -un)" ]; then d_ok "自動ログインが有効です"
    else d_need "自動ログインが無効です(再起動後、ログインするまで起動しません)" "システム設定 > ユーザとグループ > 自動ログイン で $(id -un) を選ぶ"; fi
  fi

  for name in $(list_names); do
    if ! ( load_conf "$name" ) >/dev/null 2>&1; then
      d_ng "[$name] 設定を読めません: $( ( load_conf "$name" ) 2>&1 | head -1)" "$CONF_DIR/$name.conf を直す"
      continue
    fi
    load_conf "$name"
    { [ "$ENABLED" = "1" ] && [ "$(this_host)" = "$HOST" ]; } || continue
    if ! command -v launchctl >/dev/null 2>&1; then
      printf '情報    [%s] launchctl が無い環境なので、登録は確かめていません\n' "$name"
    elif [ -f "$AGENTS_DIR/$LABEL_PREFIX.$name.plist" ] && launchctl print "gui/$uid/$LABEL_PREFIX.$name" >/dev/null 2>&1; then
      d_ok "[$name] 登録されています(毎日 $(printf '%02d:%02d' "$HOUR" "$MINUTE"))"
    else d_ng "[$name] launchd に登録されていません" "claude-loop install"; fi
    if [ -d "$REPO/.git" ] || [ -f "$REPO/.git" ]; then d_ok "[$name] リポジトリがあります"
    else d_ng "[$name] リポジトリがありません: $REPO" "clone する"; continue; fi
    if [ "$NO_PUSH" = "1" ] && [ -n "$(git -C "$REPO" config --get-all remote.origin.pushurl 2>/dev/null)" ]; then
      d_ng "[$name] origin に pushurl があり、push の禁止が効きません" "git -C $REPO config --unset-all remote.origin.pushurl"
    fi
    if [ -f "$STATE_DIR/$name.last.json" ]; then
      status=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["status"]); print(d["finished"], d["detail"].split("\n")[0])' "$STATE_DIR/$name.last.json" 2>/dev/null || echo "不明")
      detail="${status#*$'\n'}"; status="${status%%$'\n'*}"
      case "$status" in
        ok|dry_run) d_ok "[$name] 直近の結果: $status ($detail)" ;;
        *) d_ng "[$name] 直近の結果: $status ($detail)" "ログを読む: $STATE_DIR/logs/$name/" ;;
      esac
    else
      printf '情報    [%s] まだ一度も実行されていません\n' "$name"
    fi
    if [ "$NO_PUSH" = "1" ]; then
      pending=$(pending_branches "$name")
      [ "$pending" -gt 0 ] && printf '情報    [%s] 確認待ちのブランチが %s本あります(%s*)。対話セッションで「変更を push して」と指示する\n' "$name" "$pending" "$(pending_prefix "$name")"
    fi
  done
  [ "$mine" -gt 0 ] || printf '情報    このマシン(%s)向けのループはありません\n' "$(this_host)"
  [ "$bad" -eq 0 ] && printf '\n要対応はありません\n'
  return "$bad"
}

case "${1:-}" in
  list) cmd_list ;;
  doctor) cmd_doctor ;;
  run) shift; cmd_run "$@" ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  render) [ -n "${2:-}" ] || die "使い方: claude-loop render <name>"; render_plist "$2" ;;
  *) awk 'NR > 1 && /^set -uo pipefail/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 1 ;;
esac
