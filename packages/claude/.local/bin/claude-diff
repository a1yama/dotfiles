<script>
let comments=[], FILES=[], MODE={};   // MODE: path -> 'diff' | 'prev'
const MDEXT=/\\.(md|markdown|mdown|mkd)$/i;

function key(f,l,s){return f+'@'+l+'@'+s}
function esc(s){return (s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}
function curRange(){return document.getElementById('custom').value.trim()||document.getElementById('range').value}

async function load(){
  const res=await fetch('/api/diff?range='+encodeURIComponent(curRange()));
  const data=await res.json();
  comments=data.comments;FILES=data.files;
  render(FILES);renderTree(FILES);stat();
}
async function refreshComments(){
  const res=await fetch('/api/comments');comments=await res.json();
  document.querySelectorAll('[data-anchor]').forEach(el=>{el.innerHTML=cmtHtml(el.dataset.anchor)});
  renderTree(FILES);stat();
}
function stat(){
  const c={pending:0,delivered:0,resolved:0};comments.forEach(x=>c[x.status]++);
  document.getElementById('stat').textContent=`pending ${c.pending} / delivered ${c.delivered} / resolved ${c.resolved}`;
}
function cmtHtml(anchor){
  return comments.filter(c=>key(c.file,c.line,c.side)===anchor).map(c=>
    `<div class="cmt"><div class="meta">${c.ts}<span class="badge b-${c.status}">${c.status}</span></div>${esc(c.comment)}</div>`).join('');
}
function syncHeaderOffset(){
  const h=document.querySelector('header').getBoundingClientRect().height;
  document.documentElement.style.setProperty('--hh',h+'px');
}
function pathHtml(p){
  const i=p.lastIndexOf('/');
  return i<0?`<b>${esc(p)}</b>`:`<span class="dir">${esc(p.slice(0,i+1))}</span><b>${esc(p.slice(i+1))}</b>`;
}
function fstat(f){
  let a=0,d=0;
  for(const h of f.hunks)for(const l of h.lines){if(l.type==='add')a++;else if(l.type==='del')d++}
  return {a,d};
}

/* ---------------- ファイルツリー ---------------- */
function toggleTree(){document.getElementById('tree').classList.toggle('hide')}

function buildTree(files){
  const root={dirs:new Map(),files:[]};
  files.forEach((f,idx)=>{
    const parts=f.path.split('/');
    let node=root;
    for(let i=0;i<parts.length-1;i++){
      if(!node.dirs.has(parts[i]))node.dirs.set(parts[i],{dirs:new Map(),files:[]});
      node=node.dirs.get(parts[i]);
    }
    node.files.push({name:parts[parts.length-1],idx,f});
  });
  return root;
}
// GitHub と同じく、中身が1ディレクトリだけの階層は a/b/c と畳んで縦を節約する
function compact(node,name){
  while(node.files.length===0&&node.dirs.size===1){
    const [k,v]=[...node.dirs][0];
    name=name+'/'+k;node=v;
  }
  return [name,node];
}
function treeHtml(node,depth){
  let h='';
  for(let [name,child] of [...node.dirs].sort((a,b)=>a[0].localeCompare(b[0]))){
    [name,child]=compact(child,name);
    const id='d'+Math.random().toString(36).slice(2,9);
    h+=`<div><div class="tnode tdir" onclick="foldDir('${id}',this)">`+
       `<span class="tcar">▾</span><span class="tname">${esc(name)}</span></div>`+
       `<div class="tkids" id="${id}">${treeHtml(child,depth+1)}</div></div>`;
  }
  for(const fi of node.files.sort((a,b)=>a.name.localeCompare(b.name))){
    const s=fstat(fi.f);
    const n=comments.filter(c=>c.file===fi.f.path&&c.status!=='resolved').length;
    h+=`<div class="tnode" onclick="jump(${fi.idx},this)" title="${esc(fi.f.path)}">`+
       `<span class="tcar"></span><span class="tname">${esc(fi.name)}</span>`+
       (n?`<span class="tcmt">${n}</span>`:'')+
       `<span class="tstat"><span class="tadd">+${s.a}</span> <span class="tdel">-${s.d}</span></span></div>`;
  }
  return h;
}
function renderTree(files){
  const el=document.getElementById('tree');
  if(!files.length){el.innerHTML='<div class="tsum">変更ファイルなし</div>';return}
  let a=0,d=0;files.forEach(f=>{const s=fstat(f);a+=s.a;d+=s.d});
  el.innerHTML=`<div class="tsum">${files.length} files <span class="tadd">+${a}</span> <span class="tdel">-${d}</span></div>`
    +treeHtml(buildTree(files),0);
}
function foldDir(id,el){
  const k=document.getElementById(id);k.classList.toggle('fold');
  el.querySelector('.tcar').textContent=k.classList.contains('fold')?'▸':'▾';
}
function jump(idx,el){
  document.querySelectorAll('#tree .tnode.sel').forEach(x=>x.classList.remove('sel'));
  if(el)el.classList.add('sel');
  const t=document.getElementById('f'+idx);
  if(t)t.scrollIntoView({behavior:'smooth',block:'start'});
}

/* ---------------- 差分レンダリング ---------------- */
function render(files){
  const root=document.getElementById('diff');root.innerHTML='';
  if(!files.length){root.innerHTML='<div class="empty">差分はありません</div>';return}
  files.forEach((f,idx)=>{
    const div=document.createElement('div');div.className='file';div.id='f'+idx;
    const s=fstat(f);
    const tabs=MDEXT.test(f.path)
      ? `<button class="tab" data-m="diff" onclick="setMode(${idx},'diff')">差分</button>`+
        `<button class="tab" data-m="prev" onclick="setMode(${idx},'prev')">プレビュー</button>`
      : '';
    div.innerHTML=`<div class="fh">${pathHtml(f.path)}<span class="spacer"></span>`+
      `<span class="stat"><span class="tadd">+${s.a}</span> <span class="tdel">-${s.d}</span></span>${tabs}</div>`+
      `<div class="body"></div>`;
    root.appendChild(div);
    setMode(idx,MODE[f.path]||'diff');
  });
}
function diffTable(f){
  let rows='';
  for(const h of f.hunks){
    rows+=`<tr class="hh"><td class="ln"></td><td class="ln"></td><td class="gut"></td><td class="code">${esc(h.header)}</td></tr>`;
    for(const ln of h.lines){
      const cls=ln.type==='add'?'add':ln.type==='del'?'del':'';
      const lno=ln.new!=null?ln.new:(ln.old!=null?ln.old:'');
      const side=ln.type==='del'?'old':'new';
      const anc=key(f.path,lno,side);
      rows+=`<tr class="${cls}"><td class="ln">${ln.old??''}</td><td class="ln">${ln.new??''}</td>`+
        `<td class="gut" onclick="openBox('${f.path}',${lno||'null'},'${side}',this)">+</td>`+
        `<td class="code">${esc(ln.text)}</td></tr>`+
        `<tr><td colspan="2"></td><td></td><td><div data-anchor="${anc}">${cmtHtml(anc)}</div></td></tr>`;
    }
  }
  return `<table class="dt">${rows}</table>`;
}
async function setMode(idx,mode){
  const f=FILES[idx];if(!f)return;
  MODE[f.path]=mode;
  const div=document.getElementById('f'+idx);
  div.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.m===mode));
  const body=div.querySelector('.body');
  if(mode==='diff'){body.innerHTML=diffTable(f);return}
  body.innerHTML='<div class="md note">読み込み中…</div>';
  const res=await fetch('/api/file?range='+encodeURIComponent(curRange())+'&path='+encodeURIComponent(f.path));
  const data=await res.json();
  if(data.content==null){
    body.innerHTML='<div class="md note">このリビジョンにファイルがありません（削除など）。差分タブで確認してください。</div>';
    return;
  }
  body.innerHTML='<div class="md">'+mdToHtml(data.content)+'</div>';
}

/* ---------------- 最小限の Markdown レンダラ ----------------
   依存を増やさないため CDN も Python ライブラリも使わない。
   GFM のうち見出し/リスト/表/コード/引用/水平線/インライン装飾だけを扱う。 */
function safeUrl(u){
  const t=u.trim();
  return /^(https?:|mailto:|#|\\/|\\.)/i.test(t)?t:'#';
}
function inline(s){
  s=esc(s);
  const codes=[];
  s=s.replace(/`([^`]+)`/g,(m,c)=>{codes.push(c);return '\\u0001'+(codes.length-1)+'\\u0001'});
  s=s.replace(/!\\[([^\\]]*)\\]\\(([^)\\s]+)[^)]*\\)/g,(m,a,u)=>`<img alt="${a}" src="${safeUrl(u)}">`);
  s=s.replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)[^)]*\\)/g,(m,t,u)=>`<a href="${safeUrl(u)}" target="_blank" rel="noopener">${t}</a>`);
  s=s.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>');
  s=s.replace(/__([^_]+)__/g,'<strong>$1</strong>');
  s=s.replace(/(^|[^*\\w])\\*([^*\\n]+)\\*/g,'$1<em>$2</em>');
  s=s.replace(/~~([^~]+)~~/g,'<del>$1</del>');
  s=s.replace(/\\u0001(\\d+)\\u0001/g,(m,n)=>'<code>'+codes[+n]+'</code>');
  return s;
}
const ITEM=/^(\\s*)([-*+]|\\d+[.)])\\s+(.*)$/;
function isBlockStart(l){
  return /^\\s*$/.test(l)||/^\\s*(```|~~~)/.test(l)||/^ {0,3}#{1,6}\\s/.test(l)
       ||/^ {0,3}(-{3,}|\\*{3,}|_{3,})\\s*$/.test(l)||/^ {0,3}>/.test(l)||ITEM.test(l);
}
function listNodes(items){
  const root=[];const path=[{indent:-1,children:root}];
  for(const it of items){
    while(path.length>1&&it.indent<=path[path.length-1].indent)path.pop();
    const node={text:it.text,children:[],indent:it.indent};
    path[path.length-1].children.push(node);path.push(node);
  }
  return root;
}
function listHtml(nodes,ordered){
  const tag=ordered?'ol':'ul';
  return `<${tag}>`+nodes.map(n=>{
    const cb=n.text.match(/^\\[([ xX])\\]\\s+([\\s\\S]*)$/);
    const body=cb
      ? `<input type="checkbox" disabled${/[xX]/.test(cb[1])?' checked':''}> `+inline(cb[2])
      : inline(n.text);
    return `<li>${body}${n.children.length?listHtml(n.children,ordered):''}</li>`;
  }).join('')+`</${tag}>`;
}
function mdToHtml(src){
  const lines=src.replace(/\\r\\n?/g,'\\n').split('\\n');
  const out=[];let i=0;
  while(i<lines.length){
    const l=lines[i];
    if(/^\\s*$/.test(l)){i++;continue}
    const fence=l.match(/^\\s*(```+|~~~+)/);
    if(fence){
      const mark=fence[1];const buf=[];i++;
      while(i<lines.length&&!lines[i].trimStart().startsWith(mark)){buf.push(lines[i]);i++}
      i++;
      out.push('<pre><code>'+esc(buf.join('\\n'))+'</code></pre>');continue;
    }
    if(/^ {0,3}(-{3,}|\\*{3,}|_{3,})\\s*$/.test(l)){out.push('<hr>');i++;continue}
    const h=l.match(/^ {0,3}(#{1,6})\\s+(.*)$/);
    if(h){
      const n=h[1].length;
      out.push(`<h${n}>${inline(h[2].replace(/\\s+#+\\s*$/,''))}</h${n}>`);i++;continue;
    }
    // 表: 1行目にパイプがあり、2行目が --- 区切り行
    if(l.includes('|')&&i+1<lines.length&&/^\\s*\\|?[\\s:|-]*-[\\s:|-]*$/.test(lines[i+1])&&lines[i+1].includes('|')){
      const cut=r=>r.replace(/^\\s*\\|/,'').replace(/\\|\\s*$/,'').split('|').map(c=>c.trim());
      const head=cut(l);
      const al=cut(lines[i+1]).map(c=>/^:-+:$/.test(c)?'center':/^-+:$/.test(c)?'right':'left');
      i+=2;
      let t='<div class="mdscroll"><table><thead><tr>'+
        head.map((c,k)=>`<th style="text-align:${al[k]||'left'}">${inline(c)}</th>`).join('')+'</tr></thead><tbody>';
      while(i<lines.length&&lines[i].includes('|')&&!/^\\s*$/.test(lines[i])){
        t+='<tr>'+cut(lines[i]).map((c,k)=>`<td style="text-align:${al[k]||'left'}">${inline(c)}</td>`).join('')+'</tr>';
        i++;
      }
      out.push(t+'</tbody></table></div>');continue;
    }
    if(/^ {0,3}>/.test(l)){
      const buf=[];
      while(i<lines.length&&/^ {0,3}>/.test(lines[i])){buf.push(lines[i].replace(/^ {0,3}>\\s?/,''));i++}
      out.push('<blockquote>'+mdToHtml(buf.join('\\n'))+'</blockquote>');continue;
    }
    if(ITEM.test(l)){
      const items=[];let ordered=null;
      while(i<lines.length){
        const m=lines[i].match(ITEM);
        if(m){
          if(ordered===null)ordered=/\\d/.test(m[2]);
          items.push({indent:m[1].replace(/\\t/g,'    ').length,text:m[3]});i++;
        }else if(/^\\s*$/.test(lines[i])){
          if(i+1<lines.length&&(ITEM.test(lines[i+1])||/^\\s{2,}\\S/.test(lines[i+1]))){i++;continue}
          break;
        }else if(/^\\s{2,}\\S/.test(lines[i])&&items.length){
          items[items.length-1].text+='\\n'+lines[i].trim();i++;
        }else break;
      }
      out.push(listHtml(listNodes(items),ordered));continue;
    }
    const buf=[];
    while(i<lines.length&&!isBlockStart(lines[i])){buf.push(lines[i]);i++}
    if(buf.length)out.push('<p>'+inline(buf.join('\\n'))+'</p>');
    else i++;  // isBlockStart を通り抜けた未対応行で止まらないための保険
  }
  return out.join('\\n');
}

/* ---------------- コメント入力 ---------------- */
function openBox(file,line,side,gut){
  const tr=gut.closest('tr');
  if(tr.nextSibling&&tr.nextSibling.querySelector&&tr.nextSibling.querySelector('.cbox'))return;
  const box=document.createElement('tr');
  box.innerHTML=`<td colspan="2"></td><td></td><td><div class="cbox">
    <textarea placeholder="この行へのフィードバック…"></textarea>
    <div class="row"><button>送信</button><button class="cancel">取消</button></div></div></td>`;
  tr.after(box);
  const ta=box.querySelector('textarea');ta.focus();
  box.querySelector('button').onclick=async()=>{
    const v=ta.value.trim();if(!v)return;
    await fetch('/api/comment',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({file,line,side,comment:v})});
    box.remove();refreshComments();
  };
  box.querySelector('.cancel').onclick=()=>box.remove();
}
const poll=setInterval(()=>{if(document.getElementById('auto').checked&&!document.querySelector('.cbox'))refreshComments()},3000);
async function finish(){
  clearInterval(poll);
  let c={pending:0,delivered:0,resolved:0};
  try{c=(await (await fetch('/api/finish',{method:'POST'})).json()).counts||c}catch(e){}
  const left=c.pending+c.delivered;
  document.body.innerHTML='<div class="empty">レビュー完了を Claude に通知しました。<br>'+
    (left?`未対応のコメントが ${left} 件あります。Claude が対応します。<br>`:'')+
    'サーバは停止したので、このタブは閉じて構いません。</div>';
}
addEventListener('resize',syncHeaderOffset);
syncHeaderOffset();
load();
</script></body></html>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    root = None
    fb = None
    ctl = None
    last_seen = 0.0

    def log_message(self, *a):
        pass

    def _touch(self):
        Handler.last_seen = time.time()

    def _shutdown_later(self):
        # serve_forever を呼んでいるスレッドから shutdown すると deadlock するので別スレッドで
        threading.Thread(target=self.server.shutdown, daemon=True).start()

    def _json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        self._touch()
        u = urlparse(self.path)
        if u.path == "/":
            body = PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif u.path == "/api/diff":
            rng = parse_qs(u.query).get("range", ["uncommitted"])[0]
            files = parse_diff(get_diff_text(self.root, rng))
            self._json({"files": files, "comments": read_feedback(self.fb)})
        elif u.path == "/api/comments":
            self._json(read_feedback(self.fb))
        elif u.path == "/api/file":
            q = parse_qs(u.query)
            rng = q.get("range", ["uncommitted"])[0]
            path = q.get("path", [""])[0]
            self._json({"path": path, "content": read_new_side(self.root, rng, path)})
        else:
            self.send_error(404)

    def do_POST(self):
        self._touch()
        path = urlparse(self.path).path
        if path == "/api/finish":
            items = read_feedback(self.fb)
            counts = {"pending": 0, "delivered": 0, "resolved": 0}
            for x in items:
                counts[x["status"]] = counts.get(x["status"], 0) + 1
            mark_finished(self.ctl, "user")
            self._json({"ok": True, "counts": counts})
            self._shutdown_later()
            return
        if path != "/api/comment":
            return self.send_error(404)
        ln = int(self.headers.get("Content-Length", 0))
        data = json.loads(self.rfile.read(ln) or b"{}")
        item = {
            "id": hashlib.sha1(
                f"{data.get('file')}{data.get('line')}{time.time()}".encode()
            ).hexdigest()[:8],
            "ts": time.strftime("%Y-%m-%d %H:%M"),
            "file": data.get("file", ""),
            "line": data.get("line"),
            "side": data.get("side", "new"),
            "comment": data.get("comment", ""),
            "status": "pending",
        }
        with FileLock(self.fb):
            items = read_feedback(self.fb)
            items.append(item)
            write_feedback(self.fb, items)
        self._json({"ok": True, "id": item["id"]})


def idle_reaper(httpd, ctl, idle_timeout):
    """ブラウザを閉じたまま放置されたときにサーバを残さないための保険。"""
    while True:
        time.sleep(5)
        if time.time() - Handler.last_seen < idle_timeout:
            continue
        mark_finished(ctl, "idle")
        threading.Thread(target=httpd.shutdown, daemon=True).start()
        return


def cmd_serve(args):
    root = repo_root()
    Handler.root = root
    Handler.fb = feedback_path(root)
    Handler.ctl = control_path(root)
    Handler.last_seen = time.time()
    # 前回の完了マーカーが残っていると watch が即座に DONE を返してしまう
    clear_control(Handler.ctl)
    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{args.port}/"
    print(f"claude-diff serving {root}\n  {url}\n  feedback: {Handler.fb}")
    if not args.no_open:
        webbrowser.open(url)
    if args.idle_timeout > 0:
        threading.Thread(
            target=idle_reaper, args=(httpd, Handler.ctl, args.idle_timeout), daemon=True
        ).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        mark_finished(Handler.ctl, "interrupted")
    reason = read_control(Handler.ctl).get("reason", "")
    print(f"claude-diff stopped ({reason or 'shutdown'})")


def cmd_watch(args):
    root = repo_root()
    fb = feedback_path(root)
    ctl = control_path(root)
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        ctrl = read_control(ctl)
        if ctrl.get("finished"):
            items = read_feedback(fb)
            c = {"pending": 0, "delivered": 0, "resolved": 0}
            for x in items:
                c[x["status"]] = c.get(x["status"], 0) + 1
            why = {
                "user": "ユーザーがブラウザで「レビュー完了」を押しました",
                "idle": f"操作が無いままアイドル時間を超えたため自動終了しました",
                "interrupted": "サーバが Ctrl-C で停止されました",
            }.get(ctrl.get("reason", ""), "サーバが停止しました")
            print(f"=== DONE: レビュー終了 ===\n{why}")
            print(f"pending {c['pending']} / delivered {c['delivered']} / resolved {c['resolved']}")
            if c["pending"] or c["delivered"]:
                print("未 resolved のコメントが残っています。対応後に `claude-diff resolve all`。")
            print("サーバは停止済みです。watch を再起動する必要はありません。")
            return
        with FileLock(fb):
            items = read_feedback(fb)
            pending = [x for x in items if x["status"] == "pending"]
            if pending:
                for x in items:
                    if x["status"] == "pending":
                        x["status"] = "delivered"
                write_feedback(fb, items)
        if pending:
            print(f"=== 新しいフィードバック {len(pending)}件 ===")
            for x in pending:
                loc = f"{x['file']}:{x['line']}" if x["line"] else x["file"]
                print(f"[{x['id']}] {loc}\n  {x['comment']}")
            print("\n対応したら `claude-diff resolve <id>` で resolved にしてください。")
            return
        time.sleep(args.interval)
    print("TIMEOUT: フィードバックはありませんでした")


def cmd_resolve(args):
    root = repo_root()
    fb = feedback_path(root)
    with FileLock(fb):
        items = read_feedback(fb)
        ids = set(args.ids)
        n = 0
        for x in items:
            if x["id"] in ids or "all" in ids:
                x["status"] = "resolved"
                n += 1
        write_feedback(fb, items)
    print(f"{n}件を resolved にしました")


def cmd_status(args):
    root = repo_root()
    items = read_feedback(feedback_path(root))
    c = {"pending": 0, "delivered": 0, "resolved": 0}
    for x in items:
        c[x["status"]] = c.get(x["status"], 0) + 1
    print(f"pending {c['pending']} / delivered {c['delivered']} / resolved {c['resolved']}")
    for x in items:
        if x["status"] != "resolved":
            loc = f"{x['file']}:{x['line']}" if x["line"] else x["file"]
            print(f"  [{x['id']}] {x['status']:9} {loc}  {x['comment'][:60]}")


def cmd_tmux(args):
    """別ペインに色付き git diff を定期更新で表示（軽量ビューア=B案）。"""
    root = repo_root()
    pager = "delta --paging=never" if subprocess.run(
        ["which", "delta"], capture_output=True
    ).returncode == 0 else "less -R"
    rng = args.range if args.range != "uncommitted" else "HEAD"
    inner = (
        f"cd {root}; while true; do clear; "
        f"git -c color.ui=always diff {rng} | {pager}; "
        f"echo '--- {args.interval}s毎に更新 (Ctrl-C で終了) ---'; sleep {args.interval}; done"
    )
    if subprocess.run(["which", "tmux"], capture_output=True).returncode != 0:
        sys.exit("tmux が見つかりません")
    if os.environ.get("TMUX"):
        subprocess.run(["tmux", "split-window", "-h", inner])
    else:
        subprocess.run(["tmux", "new-session", "-d", "-s", "claude-diff", inner])
        print("tmux セッション 'claude-diff' を作成しました: tmux attach -t claude-diff")


def main():
    p = argparse.ArgumentParser(description="claude-diff")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("serve")
    s.add_argument("--port", type=int, default=4517)
    s.add_argument("--no-open", action="store_true")
    s.add_argument("--idle-timeout", type=int, default=1800,
                   help="無操作がこの秒数続いたらサーバを自動停止する（0で無効）")
    s.set_defaults(func=cmd_serve)

    w = sub.add_parser("watch")
    w.add_argument("--timeout", type=int, default=1800)
    w.add_argument("--interval", type=int, default=2)
    w.set_defaults(func=cmd_watch)

    r = sub.add_parser("resolve")
    r.add_argument("ids", nargs="+")
    r.set_defaults(func=cmd_resolve)

    st = sub.add_parser("status")
    st.set_defaults(func=cmd_status)

    t = sub.add_parser("tmux")
    t.add_argument("--range", default="uncommitted")
    t.add_argument("--interval", type=int, default=3)
    t.set_defaults(func=cmd_tmux)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
